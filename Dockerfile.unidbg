FROM docker.m.daocloud.io/library/alpine:3.22 AS downloader

ARG UNIDBG_VERSION=0.0.6
ARG UNIDBG_SHA256=505fa249c37365cde4bcaafcd433cc6e8af83fdfb1948a5b145ddc5a45293cfb

RUN apk add --no-cache ca-certificates curl \
    && curl -fL --retry 3 \
      -o /tmp/app.jar \
      "https://gh-proxy.com/https://github.com/mtongle/fqnovel-unidbg/releases/download/v${UNIDBG_VERSION}/unidbg-boot-server-${UNIDBG_VERSION}.jar" \
    && echo "${UNIDBG_SHA256}  /tmp/app.jar" | sha256sum -c -

FROM docker.m.daocloud.io/library/eclipse-temurin:17-jre

WORKDIR /app

COPY --from=downloader /tmp/app.jar app.jar

EXPOSE 8099

CMD ["java", "-jar", "app.jar"]
