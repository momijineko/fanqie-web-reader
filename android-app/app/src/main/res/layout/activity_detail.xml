<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/sp_3">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/sp_3"
            app:cardCornerRadius="@dimen/radius_lg"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/sp_5">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="@dimen/radius_sm"
                        app:cardElevation="2dp"
                        android:layout_marginEnd="@dimen/sp_4">

                        <ImageView
                            android:id="@+id/iv_cover"
                            android:layout_width="@dimen/cover_detail_w"
                            android:layout_height="@dimen/cover_detail_h"
                            android:src="@drawable/ic_book_placeholder"
                            android:background="@drawable/bg_cover_placeholder"
                            android:scaleType="centerCrop" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/fs_xl"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="2dp" />

                        <TextView
                            android:id="@+id/tv_author"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sp_2"
                            android:textSize="@dimen/fs_sm"
                            android:textColor="@color/text_secondary" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="@dimen/sp_2"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tv_category"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/fs_xs"
                                android:textColor="@color/accent"
                                android:background="@color/accent_light"
                                android:paddingVertical="2dp" android:paddingHorizontal="8dp"
                                android:layout_marginEnd="@dimen/sp_2" />

                            <TextView
                                android:id="@+id/tv_score"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/fs_xs"
                                android:textColor="@color/text_muted"
                                android:layout_marginEnd="@dimen/sp_2" />

                            <TextView
                                android:id="@+id/tv_word_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/fs_xs"
                                android:textColor="@color/text_muted" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sp_4"
                    android:textSize="@dimen/fs_base"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="4dp"
                    android:maxLines="4"
                    android:ellipsize="end" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/sp_4">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_read"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="开始阅读"
                        style="@style/Widget.Fanqie.Button.Primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_add_shelf"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/sp_2"
                        android:text="加入书架"
                        style="@style/Widget.Fanqie.Button.Outlined" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="目录"
            android:textSize="@dimen/fs_lg"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginStart="@dimen/sp_2"
            android:layout_marginBottom="@dimen/sp_2" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/radius_md"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/card_bg">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_chapters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
        </com.google.android.material.card.MaterialCardView>

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/sp_4"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
