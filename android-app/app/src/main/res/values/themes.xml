<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme -->
    <style name="Theme.Fanqie" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/accent_container</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/card_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowContentTransitions">false</item>
    </style>

    <!-- Reader theme (full screen) -->
    <style name="Theme.Fanqie.Reader" parent="Theme.Fanqie">
        <item name="android:windowBackground">@color/reader_bg</item>
        <item name="android:statusBarColor">@color/reader_bg</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.Fanqie.Button.Primary" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/radius_sm</item>
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/fs_md</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Fanqie.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/radius_sm</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Card -->
    <style name="Widget.Fanqie.CardView" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/radius_sm</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/card_bg</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Text appearances -->
    <style name="TextAppearance.Fanqie.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/fs_xl</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Fanqie.Subtitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/fs_md</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Fanqie.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/fs_base</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Fanqie.BodySecondary" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/fs_sm</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Fanqie.Caption" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/fs_xs</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>
</resources>
