# 番茄小说阅读器 - 环境变量示例
# 复制为 .env 并按需修改（.env 已被 gitignore，不会提交）
# 本地启动脚本（start.bat / start.sh）和 Docker 部署都会加载 .env；
# 系统已存在的同名环境变量优先，.env 不会覆盖它们。

# CORS 允许的来源，多个用逗号分隔；设为 * 则关闭凭证模式
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8199,http://127.0.0.1:8199

# 备用社区 API（unidbg 不可用时兜底；搜索/详情/章节/正文优先走 unidbg）
# 支持逗号分隔多个实例，请求时按序轮询，任一实例可用即生效
COMMUNITY_API=http://101.35.133.34:5000,https://tt.sjmyzq.cn

# unidbg 签名代理（fqnovel-unidbg）：主数据源（搜索/详情/章节/正文）+ 段评
UNIDBG_API=http://127.0.0.1:8099
# 段评默认走真实 unidbg。PARA_COMMENT_MOCK 仅供开发调试：没启动 unidbg 时
# 预览段评的格式和样式，显示的是假数据，切勿在日常使用/生产环境开启。
PARA_COMMENT_MOCK=false

# Redis 连接（供 unidbg 缓存用，Python 端不直接使用）
REDIS_PASSWORD=fanqie_unidbg_2026

# unidbg 管理后台密码（必填；可用 `openssl rand -base64 32` 生成）
UNIDBG_ADMIN_PASSWORD=
